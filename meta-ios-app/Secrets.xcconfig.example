// Secrets.xcconfig — copy to `Secrets.xcconfig` and fill in. NEVER commit the filled-in file.
//
// The iOS counterpart of meta-android-app/local.properties. Same discipline: every key is read at
// build time and injected through Info.plist, and a MISSING KEY IS NEVER A BUILD ERROR — it becomes
// an empty string and fails later at runtime with a named line (`start failed: no gemini_api_key`)
// rather than a mysterious network error. That is deliberate, and it is why this file exists: until
// it did on Android, the only way to discover the keys was to read the build script.
//
// TWO XCCONFIG TRAPS, both of which will waste an afternoon:
//
//   1. `//` STARTS A COMMENT. A URL must be written `https:/$()/host` — the `$()` is an empty
//      substitution that breaks up the `//` without appearing in the value.
//   2. Info.plist preprocessing STRIPS `://` unless the target sets `-traditional-cpp`
//      (Apple TN2175 — Meta's own iOS integration doc calls this out). This is why
//      MWDAT.AppLinkURLScheme is hardcoded as `saifi://` in Info.plist rather than substituted.

// ── Meta AI registration ─────────────────────────────────────────────────────────────────────────
//
// From the Wearables Developer Center. `0` is accepted while Developer Mode is on in the Meta AI
// app, which is the whole local loop — you need nothing from the Developer Center to run this on
// your own phone. Developer Mode also skips app attestation, which is what TeamID is for.
//
// Only ONE third-party DAT app can be registered at a time per Meta account: registering this app
// UNREGISTERS ai.simular.saiglasses (the Android build) on the same account, and vice versa. Use a
// second Meta account if you need both usable at once.
META_APP_ID = 0
CLIENT_TOKEN =

// TeamID is NOT set here — it comes from DEVELOPMENT_TEAM in Signing & Capabilities, and Info.plist
// reads it as $(DEVELOPMENT_TEAM). iOS attestation binds to it, which is why the key exists on iOS
// and has no Android counterpart.

// ── Your own Gemini API key ──────────────────────────────────────────────────────────────────────
//
// The app opens the Gemini Live session DIRECTLY with this key — audio never goes through any server
// of ours, and there is no server-minted token. Get one from https:/$()/aistudio.google.com/ and note
// that YOU pay Google for what the voice half uses.
//
// It ends up as a plaintext string in the built app, exactly as it does in the APK. Fine for a build
// you run yourself; NOT fine for a build you hand to someone else or push to TestFlight.
GEMINI_API_KEY =

// ── The Sai agent API ────────────────────────────────────────────────────────────────────────────
//
// Reaches your Sai AGENT. The voice conversation needs nothing from it and costs nothing here.
// An empty value fails at runtime with `no sai_api_url`.
SAI_API_URL = https:/$()/api.sai.simular.ai

// Optional. Pins the app to one server revision via the `x-sai-version` header. Leave blank against
// production.
SAI_VERSION_TAG =

// ── Google sign-in (Firebase ID token) ───────────────────────────────────────────────────────────
//
// THESE ARE NOT THE ANDROID VALUES. `firebase_app_id` and `firebase_api_key` in local.properties are
// an ANDROID app id and an ANDROID key. You must add an **iOS app** to the same Firebase project for
// bundle id `ai.simular.saifi` and take the iOS values from there.
//
// There is no GoogleService-Info.plist, mirroring the Android decision to have no
// google-services.json: FirebaseApp.configure(options:) is built in code from these values.
//
// There is also no SHA-1 step on iOS. The equivalent is registering the bundle id in Firebase and
// adding REVERSED_CLIENT_ID as a URL scheme so GoogleSignIn can be called back.
FIREBASE_APP_ID =            // the iOS app id, shaped 1:<project-number>:ios:<hash>
FIREBASE_API_KEY =           // the iOS API key
FIREBASE_PROJECT_ID =
FIREBASE_GCM_SENDER_ID =     // the project number; FirebaseOptions requires it even without FCM
IOS_CLIENT_ID =              // the OAuth **iOS** client id
REVERSED_CLIENT_ID =         // com.googleusercontent.apps.<...> — becomes a CFBundleURLScheme
WEB_CLIENT_ID =              // the OAuth **web** client id — unchanged from Android. This is the
                             // audience for a server-verifiable ID token, so it is GIDSignIn's
                             // serverClientID, not the iOS client above.
