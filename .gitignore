google-services.json

# Android Profiling
*.hprof

# ── added with the client (2026-08-07) ───────────────────────────────────────

# sample.keystore is the DEBUG signing config and stays TRACKED, against the
# `*.keystore` rule above. It came from Meta's public CameraAccess sample, and a
# STABLE debug signature is what the Meta AI DAT registration binds to — drop it
# and every clone signs with a different key, so registration silently stops
# working with nothing to point at.
!meta-android-app/app/sample.keystore

# local.properties is ignored above; this is the template that documents it.
!meta-android-app/local.properties.example

# presenter (Node) — the demo dashboard is polyglot with the Android app
node_modules/
dist/

# macOS
.DS_Store

# ── iOS (meta-ios-app (untested on-device)) ────────────────────────────────────
# The filled-in secrets file, never the example beside it.
meta-ios-app (untested on-device)/Secrets.xcconfig
!meta-ios-app (untested on-device)/Secrets.xcconfig.example
# Xcode and SwiftPM build state.
meta-ios-app (untested on-device)/**/.build/
meta-ios-app (untested on-device)/**/*.xcuserdatad
meta-ios-app (untested on-device)/**/xcuserdata/
meta-ios-app (untested on-device)/**/DerivedData/
meta-ios-app (untested on-device)/**/.swiftpm/
