<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice call audio: capture the glasses mic and route BT voice audio over HFP/SCO (full-duplex). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- "Near me" requests: the agent runs on a datacenter VM, so the phone is the only thing that
         knows where the user actually is. Read per request, never streamed. FINE and COARSE are both
         declared because Android 12+ lets the user grant COARSE only, which PhoneLocation honours. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Keep the voice call running with the screen off (mic foreground service) + its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".saispike.SaiFiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Sai-Fi"
        android:supportsRtl="true"
        android:theme="@style/Theme.CameraAccess">

        <!-- Meta Wearables Device Access Toolkit Setup -->
        <!-- Without Developer Mode, these values need to be set with credentials from the app registered in Wearables Developer Center -->
        <!-- DAT registration, from local.properties (mwdat_application_id / mwdat_client_token).
             NOT committed: the client token is a credential, and this app is published open-source.
             Without them the app builds but Meta AI will not grant it a device session. -->
        <meta-data android:name="com.meta.wearable.mwdat.APPLICATION_ID" android:value="${mwdat_application_id}" />
        <meta-data android:name="com.meta.wearable.mwdat.CLIENT_TOKEN" android:value="${mwdat_client_token}" />

        <!-- DAT registration deep-link callback host — NOT a launcher. The Meta AI app returns here via
             the saiwearables scheme after registration/permission flows; the DAT SDK consumes the
             callback and the result surfaces via Wearables.registrationState. Reachable via the deep
             link regardless of launcher status. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CameraAccess">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="saiwearables" />
            </intent-filter>
        </activity>

        <!-- The voice concierge is the app's LAUNCHER / default activity (single home-screen icon;
             Android Studio "Run" opens this). MainActivity above is intentionally not a launcher, so
             there's exactly one icon and no activity to close/switch. -->
        <activity
            android:name=".saispike.VoiceConciergeActivity"
            android:exported="true"
            android:theme="@style/Theme.CameraAccess">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The microphone foreground service that owns the call (survives screen-off/pocket). The
             presenter screen mirror captures the app's own window via PixelCopy, so it needs no
             mediaProjection type and no capture permission.

             `location` is in the type list because this service reads the phone's location for a
             "near me" request, and it does so precisely while it is foregrounded — the whole point
             is that the call keeps running in the user's pocket. From Android 14 a foreground
             service that touches location without declaring the type throws SecurityException, so
             this is load-bearing, not documentation. -->
        <service
            android:name=".saispike.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|location" />

    </application>
</manifest>
